# Copy to .env and fill in. .env is gitignored; never commit a real key.
ANTHROPIC_API_KEY=sk-ant-...

# Keep anthropic for the proven Claude path, or set openrouter for alternate models.
MCGOD_MODEL_PROVIDER=anthropic
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MCGOD_OPENROUTER_CLASSIFY_MODEL=openai/gpt-5.6-luna
MCGOD_OPENROUTER_DIALOGUE_MODEL=openai/gpt-5.6-luna
MCGOD_OPENROUTER_VISION_MODEL=google/gemini-3.7-flash
MCGOD_OPENROUTER_REASONING_EFFORT=low

# CLAUDE.md L6: cheap model for triage and classification, strong model for
# dialogue and judgment. P8 is classification only, so it uses the cheap one.
MCGOD_CLASSIFY_MODEL=claude-haiku-4-5
MCGOD_DIALOGUE_MODEL=claude-opus-5
# Optional; unset keeps the proven dialogue model for Claude vision calls.
# MCGOD_VISION_MODEL=claude-opus-5

# Model classifications below this confidence are stored but never assertable.
MCGOD_INFERRED_THRESHOLD=0.75
